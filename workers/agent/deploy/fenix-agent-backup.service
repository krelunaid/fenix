[Unit]
Description=Fenix agent — snapshot of published apps and their data
After=fenix-agent.service

[Service]
Type=oneshot
User=fenix
Group=fenix
WorkingDirectory=/opt/fenix
EnvironmentFile=/etc/fenix-agent.env
ExecStart=/usr/bin/node workers/agent/backup.mjs snapshot
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/fenix-agent /var/backups/fenix-agent
