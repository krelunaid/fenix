# Fenix — server only. Never VITE_XAI_API_KEY.

XAI_API_KEY=
VITE_AUTH_ENABLED=false

# Visual worker (Railway). Server only. The browser never reaches the worker directly:
# /__worker/* and /api/polish|jobs add this token. Set the SAME value on Railway
# (VISUAL_WORKER_TOKEN) and on Netlify. On Railway the worker refuses jobs without it.
# VISUAL_WORKER_URL=https://fenix-production-d9f5.up.railway.app
# VISUAL_WORKER_TOKEN=
# Public origin of Fenix (CORS allow-list for the worker, origin guard for /api/build).
# FENIX_ORIGIN=https://fenix.kreluna.it

# Agent worker (workers/agent, Claude + Docker sandbox). Server only. Fenix proxies
# /api/agent/* to it with this token and charges credits on the server (Netlify Blobs).
# AGENT_URL=https://agent.example.com
# AGENT_TOKEN=

# Release host credentials. Names only. Values live on the server, never in the client.
# NETLIFY_AUTH_TOKEN=
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_TEAM_ID=
# Optional iOS distribution cert (P12 + profile), used only if automatic provisioning is not enough:
# APPLE_DISTRIBUTION_P12_BASE64=
# APPLE_DISTRIBUTION_P12_PASSWORD=
# APPLE_PROVISIONING_PROFILE_BASE64=
# GOOGLE_PLAY_SERVICE_ACCOUNT=
# ANDROID_KEYSTORE_BASE64=
# ANDROID_KEYSTORE_PATH=
# ANDROID_KEY_ALIAS=
# ANDROID_STORE_PASSWORD=
# ANDROID_KEY_PASSWORD=
# FENIX_RELEASE_GITHUB_TOKEN=
# FENIX_RELEASE_GITHUB_REPO=
# GitHub App for product export (server only). Never VITE_*.
# Setup URL of the App: https://fenix.kreluna.it/api/github/callback
# Permissions: Contents read/write + Metadata read. Never VITE_* for the App.
# Ready only with ALL of: GITHUB_APP_ID (or CLIENT_ID), PRIVATE_KEY, SLUG, CLIENT_ID + CLIENT_SECRET
# (enable "Request user authorization (OAuth) during installation" in the App),
# and DATABASE_URL with migration 0003_github_connect_nonces. App keys alone are not enough.
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=   # required: proves the connecting user owns the installation
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_SLUG=

# FENIX_RELEASE_CALLBACK_SECRET=
# FENIX_RELEASE_CALLBACK_URL=
# DATABASE_URL=
# Project workspace sharing (viewer/editor, CAS, presence) needs DATABASE_URL
# with migration 0006_project_workspaces. Without it, collaboration stays 503.
# PostgreSQL 16 reliability harness (CI fixture, not a production secret):
# docker run --name fenix-pg16 -e POSTGRES_USER=fenix_ci -e POSTGRES_PASSWORD=fenix_ci_not_a_secret -e POSTGRES_DB=fenix_reliability -p 5432:5432 -d postgres:16
# DATABASE_URL=postgres://fenix_ci:fenix_ci_not_a_secret@127.0.0.1:5432/fenix_reliability
# npm run test:postgres-reliability
